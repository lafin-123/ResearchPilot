{
  "name": "researchpilot",
  "version": "0.8.1",
  "description": "ResearchPilot — 论文、实验与科研流水线一体化桌面智能体",
  "main": "./out/main/index.js",
  "author": "ResearchPilot",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:mcp && electron-vite dev",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build": "npm run build:mcp && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run build:mcp && node --import tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && node scripts/smoke-desktop.mjs",
    "test:notes": "npm run build && node scripts/smoke-notes.mjs",
    "test:live": "npm run build && node scripts/live-agent-desktop.mjs",
    "postinstall": "electron-builder install-app-deps",
    "package:dir": "npm run build && electron-builder --win dir",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/server": "2.2.0",
    "docx": "9.13.0",
    "js-yaml": "4.1.0",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "pptxgenjs": "^4.0.1",
    "sharp": "0.35.5",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@docx-editor.dev/core": "2.32.0",
    "@docx-editor.dev/i18n": "2.32.0",
    "@docx-editor.dev/react": "2.32.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@uiw/react-codemirror": "4.25.12",
    "@vitejs/plugin-react": "6.1.2",
    "clsx": "2.1.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "lucide-react": "1.61.0",
    "playwright-core": "^1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "zustand": "5.0.16"
  }
